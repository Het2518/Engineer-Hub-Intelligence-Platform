# ─────────────────────────────────────────────────────────────────────────────
# AI Research Assistant v3 — Environment Variables
# Copy to backend/.env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (Groq) ─────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
# V3: specdec achieves 1600+ tok/s vs ~300 tok/s — same quality, 5x faster
# Options: llama-3.3-70b-specdec | llama-3.3-70b-versatile | llama-3.1-8b-instant
LLM_CHAT_MODEL=llama-3.3-70b-specdec

# ── ChromaDB (local filesystem — no Docker required) ────────────────────────
CHROMA_PERSIST_DIR=./vectorstore

# ── Upload Directory ─────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── GitHub Integration (optional) ───────────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token

# ── Retrieval Settings ───────────────────────────────────────────────────────
TOP_K_VECTOR=10
TOP_K_FINAL=7

# ── Security (leave empty to disable auth) ───────────────────────────────────
API_KEY=
CORS_ORIGINS=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── LangSmith (optional tracing) ─────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-research-assistant-v3

# ════════════════════════════════════════════════════════════════════════════
# V2: OKF (Open Knowledge Format)
# ════════════════════════════════════════════════════════════════════════════
OKF_ENABLED=true
OKF_KNOWLEDGE_DIR=./knowledge
OKF_TRUST_BOOST=1.2
OKF_MIN_SCORE=0.25
OKF_AUTO_CREATE_ON_UPLOAD=true

# ════════════════════════════════════════════════════════════════════════════
# V2: Multi-RAG Feature Flags
# ════════════════════════════════════════════════════════════════════════════
MULTI_QUERY_ENABLED=true
MULTI_QUERY_COUNT=3
CRAG_ENABLED=true
SELF_RAG_CRITIQUE=true
WEB_SEARCH_FALLBACK=false

# ════════════════════════════════════════════════════════════════════════════
# V3: Semantic Cache — in-memory, no Redis needed
# ════════════════════════════════════════════════════════════════════════════
# Similar queries (cosine similarity >= threshold) return in ~50ms vs 6-9s
SEMANTIC_CACHE_ENABLED=true
# 0.92 = queries must be 92% similar to hit cache (lower = more hits, less precision)
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_SIZE=500
# Cache expiry in seconds (3600 = 1 hour)
SEMANTIC_CACHE_TTL=3600

# ════════════════════════════════════════════════════════════════════════════
# V3: Contextual Chunking (Anthropic method)
# ════════════════════════════════════════════════════════════════════════════
# Adds LLM-generated context prefix per chunk at upload time.
# Improves retrieval precision 49-67% (Anthropic research).
# Trade-off: adds ~0.5-2s per document at upload time (NOT at query time).
# Disable for faster uploads; enable for better retrieval quality.
CONTEXTUAL_CHUNKING_ENABLED=false

# ════════════════════════════════════════════════════════════════════════════
# V3: Adaptive Query Router
# ════════════════════════════════════════════════════════════════════════════
# Classifies queries into FAST/NORMAL/COMPLEX tiers in microseconds.
# FAST and NORMAL queries skip the LLM rewriter (saves 800-1200ms).
SMART_ROUTER_ENABLED=true
# Queries <= this many characters are candidates for FAST routing
SIMPLE_QUERY_MAX_CHARS=120