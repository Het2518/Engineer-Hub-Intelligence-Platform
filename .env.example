# ─────────────────────────────────────────────────────────────────────────────
# AI Research Assistant v2 — Environment Variables
# Copy this file to .env and fill in your values.
# Docker is NOT required. Run locally with: uvicorn main:app and npm run dev
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (Groq ONLY) ────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model options (Groq): llama-3.3-70b-versatile | mixtral-8x7b-32768 | llama-3.1-8b-instant
LLM_CHAT_MODEL=llama-3.3-70b-versatile

# ── ChromaDB (local filesystem — no Docker required) ───────────────────────
CHROMA_PERSIST_DIR=./vectorstore

# ── Upload Directory ────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── GitHub Integration (optional — for repo indexing) ──────────────────────
GITHUB_TOKEN=your_github_personal_access_token

# ── Retrieval Settings ──────────────────────────────────────────────────────
TOP_K_VECTOR=10
TOP_K_FINAL=7

# ── Security (optional — leave empty to disable auth) ──────────────────────
API_KEY=
CORS_ORIGINS=http://localhost:3000

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── LangSmith (optional — for tracing and evaluation) ──────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-research-assistant-v2

# ════════════════════════════════════════════════════════════════════════════
# V2: OKF (Open Knowledge Format — Google, June 2026)
# ════════════════════════════════════════════════════════════════════════════

# Enable the OKF deterministic knowledge layer (true = high-trust exact retrieval)
OKF_ENABLED=true

# Path to the OKF knowledge bundle directory
OKF_KNOWLEDGE_DIR=./knowledge

# Score multiplier for OKF results vs RAG results (1.2 = 20% trust boost)
OKF_TRUST_BOOST=1.2

# Minimum relevance score for OKF results to be returned (0.0-1.0)
OKF_MIN_SCORE=0.25

# Auto-create OKF docs when uploading runbooks/playbooks/incidents
OKF_AUTO_CREATE_ON_UPLOAD=true

# ════════════════════════════════════════════════════════════════════════════
# V2: Multi-RAG Feature Flags
# ════════════════════════════════════════════════════════════════════════════

# Generate multiple query variants for better recall (+35-50% on indirect Qs)
MULTI_QUERY_ENABLED=true
MULTI_QUERY_COUNT=3

# CRAG: Filter irrelevant chunks before sending to LLM (reduces hallucination)
CRAG_ENABLED=true

# Self-RAG: Post-generation grounding check (triggers 1 retry if uncited)
SELF_RAG_CRITIQUE=true

# Web search fallback when KB has < 3 relevant results (uses DuckDuckGo, no key)
WEB_SEARCH_FALLBACK=falsenge